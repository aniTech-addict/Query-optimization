{
  "name": "mongoose-queries-optimizer",
  "displayName": "Mongoose Queries Optimizer",
  "description": "A VS Code extension with React webview and Express.js backend",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mongooseOptimizer.createJsonFile",
        "title": "Mongoose Optimizer: Initialize Mongoose-Optimizer Configuration"
      },
      {
        "command": "mongooseOptimizer.clearHighlights",
        "title": "Mongoose Optimizer: Clear All Highlights"
      },
      {
        "command": "mongooseOptimizer.openPanel",
        "title": "Mongoose Optimizer: Open Activity Dashboard"
      }
    ]
  },
  "scripts": {
    "build:webview": "webpack --config webpack.config.js",
    "watch:webview": "webpack --watch --config webpack.config.js",
    "mcp:start": "node src/mcp/index.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.3.6"
  }
}
